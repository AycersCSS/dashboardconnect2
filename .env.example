# Wazuh server base URL (required)
WAZUH_API_URL="https://your-wazuh-server:55000"

# Disable SSL verification for self-signed certificates (optional, default: true)
WAZUH_SSL_VERIFY="false"

# Path to tenant-to-group mapping file (optional, default: tenants.json)
# This file maps tenant IDs to Wazuh agent groups for multi-tenant filtering.
# See tenants.json for the expected format.
# TENANTS_FILE="/etc/opencode/tenants.json"
